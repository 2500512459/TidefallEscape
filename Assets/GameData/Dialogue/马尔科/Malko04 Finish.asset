    characterName: "\u9A6C\u5C14\u79D1"
    text: "\u4F60\u5728\u79D8\u5883\u4E2D\u89C1\u8FC7\u90A3\u4E9B\u53CC\u6746\u5E06\u8239\u6CA1\u6709\uFF0C\u7FE1\u7FE0\u6D45\u6EE9\u4E2D\u5927\u591A\u6570\u6D77\u76D7\u8239\u90FD\u662F\u201C\u75A4\u8138\u201D\u83AB\u91CC\u68EE\u7684\u624B\u4E0B"
