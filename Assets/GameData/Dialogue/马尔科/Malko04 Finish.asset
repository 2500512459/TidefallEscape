    characterName: "\u9A6C\u5C14\u79D1"
    text: "\u89C1\u8FC7\u5C31\u597D\uFF0C\u90A3\u6742\u79CD\u4E0A\u4E2A\u6708\u52AB\u4E86\u8001\u5B50\u7684\u8D27\u8239\uFF0C\u4E0D\u7528\u4F60\u53BB\u6559\u8BAD\u4ED6\uFF0C\u7ED9\u6211\u72E0\u72E0\u7684\u641E\u4ED6\u7684\u624B\u4E0B\u5C31\u884C\u4E86"
