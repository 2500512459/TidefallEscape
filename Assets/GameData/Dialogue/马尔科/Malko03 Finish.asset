    options:
    - text: "\u548C\u6211\u6709\u4EC0\u4E48\u5173\u7CFB"
      targetID: Piece02
      takeQuest: 0
  - ID: Piece02
    characterName: "\u9A6C\u5C14\u79D1"
    text: "\u53EA\u8981\u627E\u5230\u5B83\u7684\u4F69\u5251\uFF0C\u5728\"\u9ED1\u5E06\u8054\u76DF\"\u5C31\u80FD\u9886\u53D6\u9AD8\u989D\u7684\u8D4F\u91D1\uFF0C\u4F60\u53BB\u5E2E\u6211\u5728\u79D8\u5883\u4E2D\u641E\u5230\u4E00\u628A\u5251\uFF0C\u51ED\u6211\u9AD8\u8D85\u7684\u6280\u827A\uFF0C\u5251\u81EA\u7136\u5C31\u51FA\u6765\u4E86\u3002"
    quest: {fileID: 11400000, guid: 68bca81bab8949d4a873e55fa615cdae, type: 2}
    options:
    - text: "\u9020\u5047\u662F\u5427"
      targetID: Piece03
      takeQuest: 0
    - text: "\u6CA1\u95EE\u9898"
      targetID: 
      takeQuest: 1
  - ID: Piece03
    characterName: "\u9A6C\u5C14\u79D1"
    text: "\u6B38\u6B38\u6B38\uFF01\u522B\u8BF4\u7684\u8FD9\u4E48\u4F4E\u4FD7\uFF0C\u51ED\u672C\u4E8B\u641E\u6765\u7684\u5251\u600E\u4E48\u80FD\u53EB\u9020\u5047\u561E\uFF0C\u5C31\u95EE\u4F60\u5E72\u4E0D\u5E72\u561B\uFF0C\u4E0D\u5E72\u6211\u627E\u522B\u4EBA\u53BB\u4E86"
