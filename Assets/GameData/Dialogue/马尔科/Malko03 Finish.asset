  dialoguePieces:
  - ID: Piece01
    characterName: "\u9A6C\u5C14\u79D1"
    text: "\u4F60\u542C\u8BF4\u2018\u8840\u5203\u2019\u7F57\u5FB7\u91CC\u683C\u65AF\u7684\u4E8B\u6CA1\uFF1F\u90A3\u53DB\u5F92\u4E0A\u4E2A\u6708\u5377\u4E86\"\u9ED1\u5E06\u8054\u76DF\"\u7684\u8D21\u91D1\u8DD1\u4E86\uFF0C\u542C\u8BF4\u4ED6\u6B7B\u5728\u4E86\u79D8\u5883\u4E4B\u4E2D\u3002"
